 "items": [
  {
   "id": "A01",
   "group": "A",
   "en": "State the population the claim is about (Turkish roads, Turkish-market cars)",
   "fa": "جامعه هدف ادعا را مشخص کن (جاده‌ها و خودروهای ترکیه)",
   "source": "REFORMS 1a",
   "v1": 1,
   "v2": 2,
   "note": "v2 defines target distribution per task"
  },
  {
   "id": "A02",
   "group": "A",
   "en": "Motivate why that population matters",
   "fa": "دلیل اهمیت این جامعه را بگو",
   "source": "REFORMS 1b",
   "v1": 1,
   "v2": 2,
   "note": "towing/insurance use case"
  },
  {
   "id": "A03",
   "group": "A",
   "en": "Motivate the use of ML instead of rules",
