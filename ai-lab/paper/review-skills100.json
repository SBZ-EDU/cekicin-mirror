   "v1": 1,
   "v2": 2,
   "note": ""
  },
  {
   "id": "A07",
   "group": "A",
   "en": "List explicit contributions",
   "fa": "سهم‌های پژوهش را صریح فهرست کن",
   "source": "CVPR form",
   "v1": 0,
   "v2": 2,
   "note": ""
  },
  {
   "id": "A08",
   "group": "A",
   "en": "Define each task precisely (detection, exact-match OCR, brand vs model)",
   "fa": "هر وظیفه را دقیق تعریف کن",
   "source": "REFORMS 3d",
   "v1": 1,
   "v2": 2,
   "note": ""
  },
  {
   "id": "A09",
   "group": "A",
   "en": "State the deployment constraint (zero budget, CPU, browser)",
   "fa": "محدودیت استقرار را بگو",
   "source": "supervisor",
   "v1": 2,
   "v2": 2,
   "note": ""
  },
  {
   "id": "A10",
   "group": "A",
   "en": "Say who benefits and how success is judged",
   "fa": "بگو چه کسی سود می‌برد و موفقیت چطور سنجیده می‌شود",
   "source": "NeurIPS significance",
   "v1": 1,
   "v2": 2,
   "note": ""
  },
  {
   "id": "B01",
   "group": "B",
   "en": "Position against the closest prior work with citations",
   "fa": "در برابر نزدیک‌ترین کارهای قبلی با ارجاع موضع بگیر",
   "source": "CVPR guideline",
   "v1": 1,
   "v2": 2,
   "note": ""
  },
  {
   "id": "B02",
   "group": "B",
   "en": "Back any \"new\" claim with specific references",
   "fa": "هر ادعای «جدید» را با ارجاع مشخص پشتیبانی کن",
   "source": "CVPR guideline",
   "v1": 1,
   "v2": 2,
   "note": ""
  },
  {
   "id": "B03",
   "group": "B",
   "en": "Avoid the novelty fallacy (new ≠ good)",
   "fa": "دچار مغالطه نوآوری نشو",
   "source": "CVPR training",
   "v1": 1,
   "v2": 2,
   "note": ""
  },
  {
   "id": "B04",
   "group": "B",
   "en": "Explain why numbers from other benchmarks are not head-to-head",
   "fa": "توضیح بده چرا عدد بنچمارک‌های دیگر قابل مقایسه مستقیم نیست",
   "source": "supervisor",
   "v1": 1,
   "v2": 2,
   "note": ""
  },
  {
   "id": "B05",
   "group": "B",
   "en": "Identify the actual novelty (Turkish evaluation, browser deployment)",
   "fa": "نوآوری واقعی را مشخص کن",
   "source": "CVPR form",
   "v1": 0,
   "v2": 2,
   "note": ""
  },
  {
   "id": "B06",
   "group": "B",
   "en": "Acknowledge that the methods are off-the-shelf",
   "fa": "بپذیر که روش‌ها آماده‌اند",
   "source": "supervisor",
   "v1": 1,
   "v2": 2,
   "note": ""
  },
  {
   "id": "B07",
   "group": "B",
   "en": "Cover the Turkish-specific literature",
   "fa": "ادبیات مخصوص ترکیه را پوشش بده",
   "source": "supervisor",
   "v1": 1,
   "v2": 1,
   "note": "only one TR LPR repo cited; TR journal papers not surveyed"
  },
  {
   "id": "B08",
   "group": "B",
   "en": "Cover VLM zero-shot literature",
   "fa": "ادبیات zero-shot مدل‌های بینایی-زبانی را پوشش بده",
