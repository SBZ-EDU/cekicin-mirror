  {
   "id": "B09",
   "group": "B",
   "en": "State the significance to practitioners",
   "fa": "اهمیت برای کاربران صنعتی را بگو",
   "source": "NeurIPS significance",
   "v1": 2,
   "v2": 2,
   "note": ""
  },
  {
   "id": "B10",
   "group": "B",
   "en": "Choose an honest target venue",
   "fa": "مجله/کنفرانس هدف را صادقانه انتخاب کن",
