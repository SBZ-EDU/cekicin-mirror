   "v1": 1,
   "v2": 2,
   "note": "v1 implied TR-fix gain; v2 reports it as not significant"
  },
  {
   "id": "A05",
   "group": "A",
   "en": "No over-claiming from small samples",
   "fa": "از نمونه کوچک ادعای بزرگ نکن",
   "source": "NeurIPS Q1",
   "v1": 0,
   "v2": 2,
   "note": "CIs now shown; n stated next to every number"
  },
  {
   "id": "A06",
   "group": "A",
   "en": "Separate measured results from aspirations",
   "fa": "نتیجه اندازه‌گیری‌شده را از هدف جدا کن",
